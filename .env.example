# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. The values below are placeholders for LOCAL development only.

# Shared HMAC secret for JWT (min 32 chars). Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-me

# Grafana admin login (user: admin)
GRAFANA_ADMIN_PASSWORD=replace-me

# Kibana: key used to encrypt saved objects (alert rules, connectors). Min 32 chars: openssl rand -hex 16
KIBANA_ENCRYPTION_KEY=replace-me-with-at-least-32-characters-long

# Trace sampling ratio (1.0 = every request). Production typically 0.05 - 0.1
TRACING_SAMPLING=1.0

# Spring profiles for the services
SPRING_PROFILES_ACTIVE=docker
