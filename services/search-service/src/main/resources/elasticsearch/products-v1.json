{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "tr_lowercase": { "type": "lowercase", "language": "turkish" },
        "folding": { "type": "asciifolding", "preserve_original": true }
      },
      "analyzer": {
        "product_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["tr_lowercase", "folding"]
        }
      },
      "normalizer": {
        "keyword_lowercase": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":          { "type": "keyword" },
      "version":     { "type": "long" },
      "sku":         { "type": "keyword", "normalizer": "keyword_lowercase" },
      "name": {
        "type": "text",
        "analyzer": "product_text",
        "fields": {
          "keyword": { "type": "keyword" },
          "suggest": { "type": "search_as_you_type", "analyzer": "product_text" }
        }
      },
      "description": { "type": "text", "analyzer": "product_text" },
      "category":    { "type": "keyword" },
      "price":       { "type": "scaled_float", "scaling_factor": 100 },
      "currency":    { "type": "keyword" },
      "attributes":  { "type": "flattened" },
      "active":      { "type": "boolean" },
      "deleted":     { "type": "boolean" },
      "updatedAt":   { "type": "date" }
    }
  }
}
